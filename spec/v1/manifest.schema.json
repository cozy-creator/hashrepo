{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cozy-creator/hashrepo/spec/v1/manifest.schema.json",
  "title": "hashrepo repository manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "files"],
  "properties": {
    "format": { "const": 1 },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "len"],
      "properties": {
        "digest": { "$ref": "#/$defs/ref" },
        "len": { "type": "integer", "minimum": 1, "maximum": 67108864 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "digest": { "$ref": "#/$defs/ref" },
        "chunks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/chunk" }
        }
      }
    }
  }
}
