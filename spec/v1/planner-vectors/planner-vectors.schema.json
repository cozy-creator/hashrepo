{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cozy-creator/tensorfs/spec/v1/planner-vectors/planner-vectors.schema.json",
  "title": "TensorFS automatic planner vectors v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format",
    "hash",
    "max_object_size",
    "fixture_encoding",
    "cases"
  ],
  "properties": {
    "$schema": {
      "const": "planner-vectors.schema.json"
    },
    "format": {
      "const": 1
    },
    "hash": {
      "const": "sha256"
    },
    "max_object_size": {
      "const": 67108864
    },
    "fixture_encoding": {
      "const": "lowercase-hex-lf-v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "length", "kind", "digest"],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "kind": {
          "enum": ["header", "tensor", "raw"]
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planner", "file_size", "objects"],
      "properties": {
        "planner": {
          "enum": ["safetensors-v1", "gguf-v1", "raw-fixed-64m-v1"]
        },
        "file_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fixture",
        "source_sha256",
        "classification",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "fixture": {
          "type": "string",
          "pattern": "^fixtures/[a-z0-9]+(?:-[a-z0-9]+)*\\.hex$"
        },
        "source_sha256": {
          "$ref": "#/$defs/digest"
        },
        "zero_tail": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "classification": {
          "enum": ["semantic", "raw", "fallback"]
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    }
  }
}
